APP_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
# Development uses SQLite; this path is ignored by Git.
LOCAL_DATABASE_PATH=instance/rentals.sqlite3
# Production requires both Supabase values.
# Keep the key server-side; never put it in browser code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_LISTING_VIEW=public_listings
LISTING_CACHE_TTL_SECONDS=90
INQUIRY_LIMIT=3
INQUIRY_WINDOW_SECONDS=1800
